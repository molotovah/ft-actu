# Identifiant France Travail et mot de passe du compte candidat
FT_ID=
FT_PASSWORD=

# Adresse Gmail qui reçoit le code de connexion France Travail (celle de ton compte France Travail)
GMAIL_USER=prenom.nom@gmail.com
# Mot de passe d'application Google (16 lettres) : https://myaccount.google.com/apppasswords
# Sert à lire le code reçu (IMAP) et à t'envoyer les notifications (SMTP).
GMAIL_APP_PASSWORD=

# Adresse publique de l'interface (sert aux liens des e-mails et aux passkeys)
BASE_URL=https://actu.example.org

# builtin (défaut) : mot de passe + 2FA/passkeys intégrés.
# proxy : seulement si un reverse proxy authentifiant (Authelia, Authentik...) protège déjà l'interface.
AUTH_MODE=builtin

# Optionnel : jeton ntfy si ton serveur ntfy exige une authentification
NTFY_TOKEN=
